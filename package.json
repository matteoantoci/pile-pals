{
  "name": "pile-pals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build && node scripts/smoke.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "knip": "knip --strict --include dependencies,unlisted,unresolved",
    "test": "vitest run --passWithNoTests",
    "check": "sh .githooks/pre-commit"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "knip": "^6.44.2",
    "oxc-config-ai-guardrails": "^1.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.18.0"
}
