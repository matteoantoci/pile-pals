{
  "name": "pile-pals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build && node scripts/smoke.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "knip": "knip --strict --include dependencies,unlisted,unresolved",
    "test": "vitest run --passWithNoTests",
    "check": "sh .githooks/pre-commit"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "canvas-confetti": "^1.9.4",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "knip": "^6.48.0",
    "oxc-config-ai-guardrails": "^1.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^3.0.0-next.27",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.23.0"
}
